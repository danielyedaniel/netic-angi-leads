# Configuration for the Angi lead integration.
#
#   cp .env.example .env      then edit .env (it is git-ignored; never commit it)
#
# Every setting of app/config.py is listed here with its default or a safe example.
# Lines marked SECRET hold credentials: the values below are placeholders, not real keys.
# Comments must be on their own line (not after a value).


# ---------------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------------

# "development" (also: dev, local, test) starts with warnings when auth is not configured.
# Any other value is treated as production, which REFUSES to start unless
# ANGI_WEBHOOK_API_KEYS and ADMIN_TOKEN are real secrets (at least 16 characters, not the
# change-me placeholders below) and FALLBACK_TENANT_SLUG is empty.
APP_ENV=development

# The address the outside world reaches this service at. It is put into every email
# (booking and unsubscribe links), so it must be the public https URL - during the demo,
# the ngrok URL - not localhost. No trailing slash needed.
PUBLIC_BASE_URL=https://your-name.ngrok-free.dev

# SQLite file. Created on first start, together with its folder.
DATABASE_PATH=data/leads.db

# Largest webhook body accepted, in bytes (bigger requests get HTTP 413). A lead is 1-3 KB.
MAX_BODY_BYTES=262144

# Create the four demo tenants and their Angi account mappings when the database is
# empty. Never done in production, whatever this says; set to false once real tenants exist.
SEED_DEMO_DATA=true


# ---------------------------------------------------------------------------------
# Inbound authentication
# ---------------------------------------------------------------------------------

# SECRET. The shared key Angi sends with every lead (X-API-KEY header). Comma-separated,
# so a key can be rotated without downtime: accept "old,new", switch Angi over, drop "old".
# Empty = the webhook accepts anyone (allowed in development only).
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ANGI_WEBHOOK_API_KEYS=change-me-webhook-key

# SECRET. Protects the dashboard, the /admin API and /metrics (Bearer token, or the
# password of the browser's login prompt). Empty = they are open (allowed in development only).
ADMIN_TOKEN=change-me-admin-token


# ---------------------------------------------------------------------------------
# Tenant mapping
# ---------------------------------------------------------------------------------

# What to do with a lead from an Angi account that is not mapped to a tenant.
#   empty (recommended)  the lead is quarantined: stored, alerted on, and processed
#                        automatically once the mapping is added. Nobody is emailed
#                        until we know which business the consumer contacted.
#   a tenant slug        the lead is routed to that tenant and answered immediately,
#                        e.g. sparkle-home-cleaning. Convenient when you only want to
#                        see emails flow, but the consumer is emailed under that
#                        tenant's name even if they contacted a different business.
#                        Production refuses to start with this set.
FALLBACK_TENANT_SLUG=


# ---------------------------------------------------------------------------------
# Outbound email
# ---------------------------------------------------------------------------------

# console  nothing is sent; each email is logged and written to data/outbox/*.eml
# smtp     any SMTP relay (the Gmail settings below)
# resend   Resend's HTTP API (needs RESEND_API_KEY and a verified sending domain)
EMAIL_PROVIDER=smtp

# The From address. Leave it empty to send from SMTP_USERNAME, which is what Gmail
# requires anyway (it rewrites anything but the account itself or one of its verified
# aliases). The From NAME is the tenant's name.
EMAIL_FROM_ADDRESS=

# Optional Reply-To for every email (a tenant's own reply address takes precedence).
EMAIL_REPLY_TO=

# Development safety valve: send EVERY email to this address instead of the lead (the
# subject then starts with "[for <the lead's address>]"). Set it to your own address
# while rehearsing with payloads that carry real addresses, so no stranger is emailed.
# Empty = off. (Independently of this, an address on example.com / .org / .net is never
# handed to a real mail server: nobody is there, and the bounce would hurt the sender.)
EMAIL_REDIRECT_ALL_TO=

# Gmail: smtp.gmail.com with port 465 + ssl (or port 587 + starttls).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# ssl | starttls | none
SMTP_SECURITY=ssl
SMTP_USERNAME=your-address@gmail.com
# SECRET. For Gmail this is an APP PASSWORD (16 characters), not the account password:
# Google Account > Security > 2-Step Verification > App passwords.
SMTP_PASSWORD=your-16-character-app-password
# Give up on a connection to the mail server after this many seconds (it is retried).
SMTP_TIMEOUT_SECONDS=15

# SECRET. Only used when EMAIL_PROVIDER=resend.
RESEND_API_KEY=


# ---------------------------------------------------------------------------------
# Speed to lead and follow-ups
# ---------------------------------------------------------------------------------

# Minutes after the intro email at which a lead who has not booked is nudged again
# (comma-separated; empty = no follow-ups). Booking, unsubscribing or closing the lead
# cancels them, and they are held back overnight (8 PM - 8 AM in the tenant's timezone).
FOLLOWUP_DELAYS_MINUTES=60,1440

# How often the background worker looks for due emails when nothing wakes it. A new lead
# wakes it immediately, so this does not delay the first response.
OUTBOX_POLL_SECONDS=2

# Quick attempts per email (the retries wait 5 s, 30 s, 2 min and 10 min). A follow-up or
# confirmation is given up after these; a lead's first response then keeps being retried
# every 30 minutes for another 24 hours.
OUTBOX_MAX_ATTEMPTS=5

# The worker that sends email, retries failed events and runs the monitoring checks.
# Only switch it off for tests; with it off nothing is sent.
RUN_BACKGROUND_WORKER=true


# ---------------------------------------------------------------------------------
# Duplicate leads and lead credits
# ---------------------------------------------------------------------------------

# A new lead from the same consumer within this many days of an earlier one is a
# duplicate (Angi: "charged twice for the same lead/homeowner within 45 days").
DUPLICATE_WINDOW_DAYS=45

# Days after the charge within which a credit must be requested (Angi Pro Terms: 30).
CREDIT_REQUEST_WINDOW_DAYS=30

# Angi only considers a credit if the pro tried to contact the homeowner this quickly.
CREDIT_CONTACT_SLA_HOURS=24


# ---------------------------------------------------------------------------------
# Monitoring and alerts
# ---------------------------------------------------------------------------------

# How often the health checks run, in seconds.
MONITOR_INTERVAL_SECONDS=60

# Speed-to-lead SLA: an email still unsent after this many seconds raises an alert.
EMAIL_SLA_SECONDS=120

# Alert when this share of recent webhook events could not be turned into leads (a sign
# that Angi changed its payload) ...
ERROR_RATE_THRESHOLD=0.2
# ... but only once at least this many events arrived ...
ERROR_RATE_MIN_EVENTS=3
# ... within this many minutes.
ERROR_RATE_WINDOW_MINUTES=60

# Alert when no webhook at all arrived for this many minutes. 0 = off; the per-tenant
# check that learns each tenant's normal rhythm runs either way.
SILENCE_ALERT_MINUTES=0

# How often scripts/canary.py is scheduled to run, in minutes (cron). When set, a canary
# that has not arrived for three intervals raises an alert, so a probe that silently
# stopped running is noticed too. 0 = not scheduled: only canary leads that do arrive
# are judged.
CANARY_INTERVAL_MINUTES=0

# SECRET. Slack incoming-webhook URL that new alerts are posted to. Empty = log only.
ALERT_SLACK_WEBHOOK_URL=

# Address that new alerts are emailed to (through the provider above). Empty = off.
ALERT_EMAIL_TO=
